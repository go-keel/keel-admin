# Paths allowed to contain Chinese text (globs, matched against the repository-relative path). One reason per entry.
# Template self-check only: a derived admin switches lint-strict to lint and writes in its team's language.
internal/i18n/*.zh-CN.toml                    # end-user localisation
internal/i18n/*.ja.toml                       # end-user localisation (Japanese example). Example: delete after forking
internal/i18n/bundle_test.go                  # asserts the zh translation
web/src/locales/*/zh-CN.ts                    # end-user localisation
web/src/locales/*/ja-JP.ts                    # end-user localisation (Japanese example). Example: delete after forking
web/src/languages.ts                          # language names are written in their own language
web/src/styles/index.css                      # Japanese menu label in a width example. Example: delete after forking
web/src/routes/_app/notices/-logic.test.ts    # test data: full-width comma handling. Example: delete after forking
scripts/check-english.sh                      # listed so its own pattern can never trip it
